# Database Configuration — copy to .env and fill in real values
# LOCAL (XAMPP): DB_HOST=localhost, DB_USER=root, DB_PASS= (empty)
# PRODUCTION (InfinityFree): use the host/user/pass from your control panel
DB_HOST=localhost
DB_NAME=interview_management_db
DB_USER=root
DB_PASS=

# Email Configuration (Gmail SMTP — use a Gmail App Password, NOT your login password)
# Google Account → Security → 2-Step Verification → App passwords → Mail
SMTP_HOST=smtp.gmail.com
SMTP_AUTH=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_SECURE=tls
SMTP_PORT=587
FROM_EMAIL=you@gmail.com
FROM_NAME="NCIA Recruitment"

# Application URLs — absolute links placed inside emails (login, sessions)
APP_URL_LOCAL=http://localhost/Interview-Process-Management
APP_URL_PROD=https://yourdomain.infinityfreeapp.com
